{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-schema/v2/schema.json",
  "productName": "NarraNexus",
  "identifier": "com.narranexus.app",
  "version": "1.21.11",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NarraNexus",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' plugin: officewatch: http://localhost:* http://127.0.0.1:*",
        "script-src": "'self' blob: plugin: 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' plugin:",
        "img-src": "'self' data: blob: plugin: http://localhost:* http://127.0.0.1:* https:",
        "media-src": "'self' data: blob: http://localhost:* http://127.0.0.1:* https:",
        "font-src": "'self' data: plugin:",
        "connect-src": "'self' blob: plugin: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:",
        "frame-src": "'self' blob: officewatch: http://localhost:* http://127.0.0.1:* https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' plugin: officewatch: http://localhost:* http://127.0.0.1:*",
        "script-src": "'self' 'unsafe-inline' blob: plugin: 'wasm-unsafe-eval' http://localhost:* http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline' plugin:",
        "img-src": "'self' data: blob: plugin: http://localhost:* http://127.0.0.1:* https:",
        "media-src": "'self' data: blob: http://localhost:* http://127.0.0.1:* https:",
        "font-src": "'self' data: plugin:",
        "connect-src": "'self' blob: plugin: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:",
        "frame-src": "'self' blob: officewatch: http://localhost:* http://127.0.0.1:* https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/python/**/*",
      "resources/project/**/*",
      "resources/nodejs/**/*",
      "resources/lark-skills/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NetMindAI-Open/NarraNexus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyN0Y5OEVGOEM4QTM2MTIKUldRU05vcU03NWgvTXNnZnZKQUpMd25jVDlGSUFVZU53WHk3ZEZpZTNIVkgvNTY5Ukh4WDVaSVEK"
    },
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["narranexus"]
      }
    }
  }
}
