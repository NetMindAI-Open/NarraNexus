{
    // Typecheck gate, starter scope (PR #202 review Minor-2): the kernel, the
    // contracts, the module system + turn pipeline, the alias package and the
    // builtin plugin packages. The other platform domains carry ~180 legacy
    // dynamic-attribute errors (tracked for paydown) and stay out until paid.
    // Batch 6a moved the tree; batch 6b put the builtin modules under plugins/.

    "include": [
        "src/narranexus/kernel",
        "packages/narranexus-contracts/src/narranexus",
        "src/narranexus/cli",
        "src/narranexus/hosts",
        "packages/narranexus-sdk/src/narranexus",
        "src/narranexus/platform/turn",
        "src/narranexus/platform/module_system",
        "src/xyz_agent_context",
        "plugins"
    ],
    "extraPaths": ["packages/narranexus-contracts/src", "packages/narranexus-sdk/src", 
        "plugins/builtin.awareness/src",
        "plugins/builtin.basic_info/src",
        "plugins/builtin.channels.discord/src",
        "plugins/builtin.channels.lark/src",
        "plugins/builtin.channels.narramessenger/src",
        "plugins/builtin.channels.slack/src",
        "plugins/builtin.channels.telegram/src",
        "plugins/builtin.channels.wechat/src",
        "plugins/builtin.chat/src", "plugins/builtin.prompts/src", "plugins/builtin.auth.local/src", "plugins/builtin.auth.netmind/src", "plugins/builtin.teams/src", "plugins/builtin.ui/src", "plugins/builtin.frameworks.claude_code/src", "plugins/builtin.frameworks.codex_cli/src", "plugins/builtin.frameworks.nexus_power/src", "plugins/builtin.turn/src", "plugins/builtin.llm_clients/src", "plugins/builtin.memory_kinds/src", "plugins/builtin.providers/src",
        "plugins/builtin.common_tools/src",
        "plugins/builtin.general_memory/src",
        "plugins/builtin.browser/src",
        "plugins/builtin.home_assistant/src",
        "plugins/builtin.job/src",
        "plugins/builtin.message_bus/src",
        "plugins/builtin.nexus_plugins_module/src",
        "plugins/builtin.skills/src",
        "plugins/builtin.social_network/src"
    ],
    "exclude": [
        "plugins/builtin.awareness/src/narranexus_plugins/awareness_module/awareness_module.py",
        "plugins/builtin.job/src/narranexus_plugins/job_module/_job_lifecycle.py",
        "plugins/builtin.job/src/narranexus_plugins/job_module/job_module.py",
        "src/narranexus/platform/module_system/run_channel_triggers.py",
        "plugins/builtin.channels.slack/src/narranexus_plugins/slack_module/slack_sdk_client.py",
        "plugins/builtin.social_network/src/narranexus_plugins/social_network_module/social_network_module.py",
        "**/tests/**"
    ],
    "typeCheckingMode": "off",
    "reportAttributeAccessIssue": "error",
    "reportUndefinedVariable": "error",
    "reportMissingImports": "error"
}
