  "provides": {
    "ingress.channels": ["nxplugins.acme_hello_channel:CHANNEL"],
    "ingress.triggers": ["nxplugins.acme_hello_channel:TRIGGERS"],
    "agent.capabilities.modules": ["nxplugins.acme_hello_channel:MODULES"]
  },
  "quality": "bronze"
}
