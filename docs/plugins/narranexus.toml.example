# narranexus.toml — which plugin fills which slot (layer USER_CONFIG: above the distribution, below NX_BIND__* env).
# One-arity slots take a plugin id; many-arity slots take an ordered list (order = effective order; unlisted = dropped).
# Distribution-only slots (kernel.*, ui) can only be set by the distribution (narranexus-dist.json) — listed for reference.
# Apply with a restart; `narranexus slots` shows what is bound and by which layer.

[bindings]

# ── Kernel (auth / db / secrets / events) — distribution-only
# kernel: Kernel root; never bound directly.  candidates: (nothing registered)
# "kernel" = "builtin.kernel"
# kernel.auth: Authentication provider; distribution-level choice.  candidates: builtin.auth.local, builtin.auth.netmind
# "kernel.auth" = "builtin.auth.local"
# kernel.db: Database backend (sqlite | sqlite_proxy | mysql).  candidates: (nothing registered)
# "kernel.db" = "builtin.kernel"
# kernel.events: Host event bus implementation.  candidates: (nothing registered)
# "kernel.events" = "builtin.kernel"
# kernel.secrets: Secret storage (secret_box | keychain | vault).  candidates: (nothing registered)
# "kernel.secrets" = "builtin.kernel"

# ── Prompt (system-prompt sections and assembler)
# prompt: Prompt domain root; its provider ships the default sections and assembler.  candidates: (nothing registered)
# "prompt" = "builtin.prompts"
# prompt.assembler: Joins the rendered sections into the final system prompt (replaceable per distribution / narranexus.toml).  candidates: builtin.prompts
# "prompt.assembler" = "builtin.prompts"
# prompt.sections: System-prompt sections (security / temporal / narrative / modules / bootstrap + plugin-defined); a binding orders or drops them.  candidates: builtin.prompts
# "prompt.sections" = ["builtin.prompts:security", "builtin.prompts:temporal", "builtin.prompts:narrative", "builtin.prompts:modules", "builtin.prompts:bootstrap"]

# ── Turn pipeline (stages, profiles, agent-loop framework)
# turn: Turn domain root.  candidates: (nothing registered)
# "turn" = "builtin.turn"
# turn.pipeline: The whole turn runtime; its provider declares the stage slots.  candidates: builtin.turn
# "turn.pipeline" = "builtin.turn"
# turn.pipeline.act: Act stage strategies (agent_loop / direct_trigger / silent); a profile names one. Child of the pipeline so replacing the pipeline owns it.  candidates: builtin.turn
# "turn.pipeline.act" = ["builtin.turn:default", "builtin.turn:silent"]
# turn.pipeline.act.framework: Agent-loop framework used by the Act stage.  candidates: builtin.frameworks.claude_code, builtin.frameworks.codex_cli, builtin.frameworks.nexus_power
# "turn.pipeline.act.framework" = "builtin.frameworks.nexus_power"
# turn.pipeline.assemble: Assemble stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.assemble" = ["builtin.turn:default"]
# turn.pipeline.commit: Commit stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.commit" = ["builtin.turn:default"]
# turn.pipeline.compose: Compose stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.compose" = ["builtin.turn:default"]
# turn.pipeline.ingress: Ingress stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.ingress" = ["builtin.turn:default"]
# turn.pipeline.recall: Recall stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.recall" = ["builtin.turn:default", "builtin.turn:narrative_fast", "builtin.turn:ephemeral"]
# turn.pipeline.reflect: Reflect stage strategies; a profile names one.  candidates: builtin.turn
# "turn.pipeline.reflect" = ["builtin.turn:default"]
# turn.profiles: Named pipeline profiles (default/fast/voice/job/silent + plugin-defined).  candidates: builtin.turn
# "turn.profiles" = ["builtin.turn:default", "builtin.turn:fast", "builtin.turn:voice", "builtin.turn:job", "builtin.turn:silent"]

# ── Models (providers, clients, resolver)
# model: Model domain root.  candidates: (nothing registered)
# "model" = "builtin.kernel"
# model.clients: Helper-LLM protocol clients (atomic call axis).  candidates: builtin.llm_clients
# "model.clients" = ["builtin.llm_clients:anthropic", "builtin.llm_clients:openai", "builtin.llm_clients:cli"]
# model.providers: LLM provider drivers (credential/endpoint axis).  candidates: builtin.providers
# "model.providers" = ["builtin.providers:custom_anthropic", "builtin.providers:custom_openai", "builtin.providers:netmind", "builtin.providers:netmind_free", "builtin.providers:yunwu", "builtin.providers:openrouter", "builtin.providers:claude_oauth", "builtin.providers:codex_oauth"]
# model.resolver: Model-name resolution. Declared only: the helper clients call the pure rule contracts.llm_client.resolve_helper_model directly; no runtime consults this slot yet, so binding it today is a no-op.  candidates: (nothing registered)
# "model.resolver" = "builtin.providers"

# ── Agent capabilities (modules, tools, memory kinds, MCP, data access)
# agent: Agent capability domain root.  candidates: (nothing registered)
# "agent" = "builtin.kernel"
# agent.capabilities: Capability namespace; its six children are the contribution slots (modules, context providers, tools, MCP servers, memory kinds, data access).  candidates: (nothing registered)
# "agent.capabilities" = "builtin.kernel"
# agent.capabilities.context_providers: Assemble-only capabilities: a stable instruction section and/or a volatile turn-context section.  candidates: (nothing registered)
# "agent.capabilities.context_providers" = []
# agent.capabilities.data_access: AgentDataStore method bodies (DirectStore dispatches by name; the store keeps parity rejects/clamps).  candidates: builtin.awareness, builtin.basic_info, builtin.chat, builtin.job, builtin.social_network
# "agent.capabilities.data_access" = ["builtin.awareness:update_awareness", "builtin.awareness:update_agent_profile", "builtin.social_network:extract_entity_info", "builtin.social_network:merge_entities", "builtin.social_network:delete_entity", "builtin.social_network:search_social_network", "builtin.social_network:get_contact_info", "builtin.social_network:get_agent_social_stats", "builtin.social_network:create_agent", "builtin.basic_info:view_narrative", "builtin.basic_info:view_event", "builtin.basic_info:switch_narrative", "builtin.job:job_retrieval_by_id", "builtin.job:job_retrieval_semantic", "builtin.job:job_retrieval_by_keywords", "builtin.job:job_update", "builtin.job:job_create", "builtin.job:job_pause", "builtin.job:job_cancel", "builtin.chat:get_chat_history"]
# agent.capabilities.mcp_servers: Site-level MCP servers merged into every agent's tool surface.  candidates: (nothing registered)
# "agent.capabilities.mcp_servers" = []
# agent.capabilities.memory_kinds: Memory kinds (recall / commit / reflect participants).  candidates: builtin.memory_kinds
# "agent.capabilities.memory_kinds" = ["builtin.memory_kinds:event", "builtin.memory_kinds:bus", "builtin.memory_kinds:narrative", "builtin.memory_kinds:entity", "builtin.memory_kinds:job", "builtin.memory_kinds:observation"]
# agent.capabilities.modules: L4 capabilities (XYZBaseModule classes — each module IS a Capability: its lifecycle methods are its stage participations); meta carries plugin_id / channel; what the platform knows about a module is its own ModuleConfig; every module server is mounted by path on the single MCP host.  candidates: builtin.awareness, builtin.basic_info, builtin.channels.discord, builtin.channels.lark, builtin.channels.narramessenger, builtin.channels.slack, builtin.channels.telegram, builtin.channels.wechat, builtin.chat, builtin.common_tools, builtin.general_memory, builtin.home_assistant, builtin.job, builtin.message_bus, builtin.nexus_plugins_module, builtin.skills, builtin.social_network
# "agent.capabilities.modules" = ["builtin.awareness:AwarenessModule", "builtin.basic_info:BasicInfoModule", "builtin.chat:ChatModule", "builtin.social_network:SocialNetworkModule", "builtin.job:JobModule", "builtin.skills:SkillModule", "builtin.message_bus:MessageBusModule", "builtin.common_tools:CommonToolsModule", "builtin.general_memory:GeneralMemoryModule", "builtin.home_assistant:HomeAssistantModule", "builtin.nexus_plugins_module:NexusPluginsModule", "builtin.channels.lark:LarkModule", "builtin.channels.slack:SlackModule", "builtin.channels.telegram:TelegramModule", "builtin.channels.wechat:WeChatModule", "builtin.channels.narramessenger:NarramessengerModule", "builtin.channels.discord:DiscordModule"]
# agent.capabilities.tools: Tool providers (Act participants); plugin tools default to tool_search.  candidates: (nothing registered)
# "agent.capabilities.tools" = []

# ── Ingress (channels, triggers)
# ingress: Ingress domain root (channels, triggers).  candidates: (nothing registered)
# "ingress" = "builtin.kernel"
# ingress.channels: IM channels: one ChannelDescriptor per channel (trigger + module + credential schema + routes + ui + transport).  candidates: builtin.channels.discord, builtin.channels.lark, builtin.channels.narramessenger, builtin.channels.slack, builtin.channels.telegram, builtin.channels.wechat, builtin.home_assistant
# "ingress.channels" = ["builtin.channels.lark:lark", "builtin.channels.slack:slack", "builtin.channels.telegram:telegram", "builtin.channels.wechat:wechat", "builtin.channels.narramessenger:narramessenger", "builtin.channels.discord:discord", "builtin.home_assistant:home_assistant"]
# ingress.triggers: Ingress triggers: IM channel listeners (host=channels), clock/queue pollers run as workers (host=workers), on-demand HTTP servers (host=api).  candidates: builtin.channels.discord, builtin.channels.lark, builtin.channels.narramessenger, builtin.channels.slack, builtin.channels.telegram, builtin.channels.wechat, builtin.chat, builtin.job
# "ingress.triggers" = ["builtin.channels.lark:lark", "builtin.channels.slack:slack", "builtin.channels.telegram:telegram", "builtin.channels.discord:discord", "builtin.channels.wechat:wechat", "builtin.channels.narramessenger:narramessenger", "builtin.job:jobs", "builtin.chat:a2a"]

# ── Backend host (routes, workers, hooks, tables, settings)
# backend: Backend service domain root.  candidates: (nothing registered)
# "backend" = "builtin.kernel"
