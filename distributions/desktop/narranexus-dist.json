    "builtin.providers": "^1.0",
    "builtin.llm_clients": "^1.0",
    "builtin.memory_kinds": "^1.0",
    "builtin.nexus_plugins_module": "^1.0",
    "builtin.turn": "^1.0",
    "builtin.awareness": "^1.0",
    "builtin.basic_info": "^1.0",
    "builtin.chat": "^1.0",
    "builtin.social_network": "^1.0",
    "builtin.job": "^1.0",
    "builtin.skills": "^1.0",
    "builtin.message_bus": "^1.0",
    "builtin.common_tools": "^1.0",
    "builtin.general_memory": "^1.0",
    "builtin.browser": "^1.0",
    "builtin.home_assistant": "^1.0",
    "builtin.channels.lark": "^1.0",
    "builtin.channels.slack": "^1.0",
    "builtin.channels.telegram": "^1.0",
    "builtin.channels.wechat": "^1.0",
    "builtin.channels.narramessenger": "^1.0",
    "builtin.channels.discord": "^1.0",
