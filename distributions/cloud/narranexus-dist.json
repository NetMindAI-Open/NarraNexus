{
  "id": "narranexus.cloud",
  "displayName": "NarraNexus Cloud",
  "description": "The official cloud distribution: every builtin except the local-only plugin factory, NetMind auth, no runtime plugins (D1).",
  "engine": ">=1.15 <2",
  "plugins": {
    "builtin.frameworks.nexus_power": "^1.0",
    "builtin.frameworks.claude_code": "^1.0",
    "builtin.frameworks.codex_cli": "^1.0",
    "builtin.providers": "^1.0",
    "builtin.llm_clients": "^1.0",
    "builtin.memory_kinds": "^1.0",
    "builtin.turn": "^1.0",
    "builtin.awareness": "^1.0",
    "builtin.basic_info": "^1.0",
    "builtin.chat": "^1.0",
    "builtin.social_network": "^1.0",
    "builtin.job": "^1.0",
    "builtin.skills": "^1.0",
    "builtin.message_bus": "^1.0",
    "builtin.common_tools": "^1.0",
    "builtin.general_memory": "^1.0",
    "builtin.home_assistant": "^1.0",
    "builtin.channels.lark": "^1.0",
    "builtin.channels.slack": "^1.0",
    "builtin.channels.telegram": "^1.0",
    "builtin.channels.wechat": "^1.0",
    "builtin.channels.narramessenger": "^1.0",
    "builtin.channels.discord": "^1.0",
    "builtin.teams": "^1.0",
    "builtin.auth.netmind": "^1.0",
    "builtin.prompts": "^1.0",
    "builtin.ui": "^1.0"
  },
  "excludes": [
    "builtin.auth.local",
    "builtin.nexus_plugins_module",
    "builtin.browser"
  ],
  "branding": {
    "name": "NarraNexus Cloud",
    "logo": "",
    "theme": ""
  },
  "auth": "builtin.auth.netmind",
  "defaults": {
    "pipelineProfile": "default",
    "agentSpec": "",
    "locale": "en"
  },
  "runtime": {
    "userPlugins": false,
    "deployment": "cloud"
  },
  "targets": [
    "docker"
  ]
}
