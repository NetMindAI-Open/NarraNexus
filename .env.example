# =============================================================================
# LLM API Keys
# =============================================================================
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Anthropic（可选）：填写 API Key 则走 API Key 模式，留空/删除则走 Claude Code OAuth 登录
# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL=""
# Claude Code OAuth（订阅）账号的瞬时错误（rate_limit / server_error）同会话重试：
# CLI 对订阅账号的 429 不重试，由适配器 resume 同一会话续跑。0 关闭；退避为逗号分隔秒数。
# 仅本地 / run.sh / DMG 生效；云端 agent_loop 跑在 executor 容器里，其 env 是 broker 白名单，
# 走代码默认值（3 次 15/30/60s），要改需 deploy 仓 broker 加 passthrough。
# CLAUDE_TRANSIENT_RETRY_ATTEMPTS=3
# CLAUDE_TRANSIENT_RETRY_BACKOFF_SECONDS="15,30,60"
# Claude Code agent loop, SUBSCRIPTION (oauth / oauth_token) accounts only: how
# many concurrency-safe tool calls of one assistant message run in parallel
# (parallel Read/Grep/MCP calls and sub-agent launches alike; CLI default 10).
# Bounds sub-agent fan-out, the 429 multiplier on a subscription. A concurrency
# cap only (every call still runs, just not all at once), never a loop ceiling.
# Keyed accounts are untouched. 0 = the CLI's own default.
# Local / run.sh / DMG only; cloud executors take the code default (6).
# CLAUDE_MAX_TOOL_USE_CONCURRENCY=6

# =============================================================================
# Database (MySQL)
# =============================================================================
# 方式一：使用 DATABASE_URL
# DATABASE_URL="mysql://root:xyz_root_pass@127.0.0.1:3306/xyz_agent_context"

# 方式二：使用独立变量（推荐，run.sh install 会自动填充 Docker MySQL 默认值）
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="xyz_agent_context"
DB_USER="root"
DB_PASSWORD="xyz_root_pass"

# =============================================================================
# Auth
# =============================================================================
ADMIN_SECRET_KEY=""

# -----------------------------------------------------------------------------
# NetMind ("Power") account login — local dual-mode (optional)
# -----------------------------------------------------------------------------
# A local install can, in addition to the always-available pure-local username
# login, let users sign in with their NetMind ("Power") account to use their
# recharged plan / quota. This is OFF by default for a hand-configured backend
# (open-source installs stay username-only). `bash run.sh` (dev-local.sh)
# turns it ON against PROD NetMind for both backend and frontend via
# scripts/dev/netmind_env.sh — NEXUS_NETMIND_ENV=dev targets the protago-dev
# stack instead, NEXUS_DEV_POWER_LOGIN=0 keeps username-only. To enable it by
# hand, uncomment the block below (PROD values; the protago-dev equivalents
# are userauth.protago-dev.com / billing.api.protago-dev.com /
# inference.api.protago-dev.com / test.api.netmind.ai/inference-api). Design:
# .mindflow/mirror/src/narranexus/platform/utils/deployment_mode.py.md
#
# NARRANEXUS_ENABLE_POWER_LOGIN=true          # show the Power login option
# NETMIND_USE_SUBSCRIPTION_ENABLED=true       # mint the Power inference key on login
# NETMIND_AUTH_API_URL=https://auth-api.netmind.ai
# BILLING_API_BASE=https://billing.api.netmind.ai
# Which Stripe account collects. Default "nexus" — the only one with Alipay and
# WeChat Pay enabled. Setting it to "power" is the ROLLBACK: it restores the
# previous shared account in one deploy, no code change. See settings.py.
# BILLING_CHANNEL=nexus
# NETMIND_KEY_API_BASE=https://inference.api.netmind.ai
# NETMIND_INFERENCE_BASE=https://api.netmind.ai/inference-api
# (KEY and INFERENCE both live under an inference.* host but are DIFFERENT
# services — KEY mints API keys, INFERENCE serves chat/messages; do not swap.)
# The frontend build/dev must also see VITE_ENABLE_POWER_LOGIN=true and the
# matching VITE_NETMIND_AUTH_API / VITE_NETMIND_ACCOUNTS_URL /
# VITE_NETMIND_SYS_CODE / VITE_NETMIND_REGISTER_URL (dev-local.sh sets them
# automatically; a desktop build must export them before build-desktop.sh,
# whose check_desktop_netmind_env.sh gate refuses a missing or non-prod set).

# =============================================================================
# Workspace（可选，有默认值）
# =============================================================================
# BASE_WORKING_PATH="./agent_workspace"

# =============================================================================
# Public origin（cloud 建议设置；影响安全）
# =============================================================================
# The public origin this deployment is served on (scheme://host). Consumed by
# settings.public_base_url for:
#   1. the artifact URL-tab self-origin guard — refuses opening a URL tab that
#      points at our own origin (which would become a same-origin scriptable
#      iframe able to read the app's token). WITHOUT this set, the cloud guard
#      falls back to the request-derived origin from the HTTP route; setting it
#      explicitly makes the guard robust for the MCP (agent-opened) path too.
#   2. the mixed-content embed check, and NetMind transcription signed URLs.
#   3. the post-payment return target for NetMind/Stripe checkout
#      (backend/routes/billing.py::_return_urls). Must be an https URL on a
#      PUBLIC host; anything else (http, or a loopback/private/single-label
#      host) keeps NetMind's own result page, so the payer finishes on a domain
#      they have never seen. Two reasons for that strictness, both measured:
#      NetMind's edge answers 403 for a loopback/private host on any scheme
#      (which our layer surfaces as a misleading 401), and Stripe's live-mode
#      behavior with a plain-http return URL is unverified. Being wrong there
#      would break checkout itself, not just the redirect — so a local install
#      (`bash run.sh`, http://localhost) deliberately gets no redirect.
# Local dev can leave it empty (localhost URLs are rejected by the SSRF rule).
# PUBLIC_BASE_URL="https://agent.narra.nexus"

# -----------------------------------------------------------------------------
# Product feedback telemetry
# -----------------------------------------------------------------------------
# The agent's submit_feedback tool and the Web UI feedback dialog report
# problems to the NarraNexus team's central intake. What leaves the machine:
# a one-line problem SUMMARY written by the agent/user, a category/severity,
# and sha256-HASHED agent/user ids — never conversation text, never raw ids.
# Set to 1 to disable all outbound feedback (self-hosted opt-out):
# NARRANEXUS_FEEDBACK_DISABLED=1
# Point at a different intake (dev/test environments):
# NARRANEXUS_FEEDBACK_URL=
#
# --- Onboarding guide agent (master default ON; backfill default OFF) -------
# First login (or any login while the user owns zero agents) auto-provisions
# a randomly-named companion agent that greets the user, teaches NarraNexus
# (narranexus-guide skill) and checks in daily via a cancellable job.
# Master kill-switch (set to 0 to disable entirely):
# NARRANEXUS_ONBOARDING_GUIDE_AGENT=0
# Backfill (default OFF): set to 1 to ALSO provision existing zero-agent
# accounts on their next login. Opt-in on purpose — measure that population
# first (each backfilled account = one daily agent-loop job on a free-tier
# wallet):
# NARRANEXUS_ONBOARDING_GUIDE_BACKFILL=1
#
# --- Self-serve signup abuse limits (cloud / Power login only) -------------
# Per-client-IP sliding windows on the unauthenticated signup routes, on top of
# the per-email limits. Raise them if many real users share one NAT egress, and
# raise them BEFORE an offline event / workshop where a whole room signs up from
# one venue network. Signup has two hourly buckets: SIGNUP_PER_IP_PER_HOUR
# counts only accounts actually created (failed attempts are refunded), and the
# looser SIGNUP_ATTEMPTS_PER_IP_PER_HOUR counts every attempt (never refunded)
# so failed attempts are still capped per IP. NETMIND_LOGIN_PER_IP_PER_HOUR
# caps POST /api/auth/netmind-login per IP (every request, never refunded:
# each one costs an upstream NetMind token check). Read at backend start:
# recreate the backend container for a change to take effect.
# Unset / empty / non-integer / < 1 falls back to the default shown.
# NARRANEXUS_SIGNUP_CODE_PER_IP_PER_MINUTE=10
# NARRANEXUS_SIGNUP_CODE_PER_IP_PER_HOUR=60
# NARRANEXUS_SIGNUP_PER_IP_PER_HOUR=20
# NARRANEXUS_SIGNUP_ATTEMPTS_PER_IP_PER_HOUR=60
# NARRANEXUS_NETMIND_LOGIN_PER_IP_PER_HOUR=120
# Funnel-report limiter (/api/auth/funnel-report, unauthenticated). The per-IP
# bucket is the real limit; the global bucket is a rotating-source backstop.
# NARRANEXUS_FUNNEL_REPORT_PER_EMAIL_LIMIT=10
# NARRANEXUS_FUNNEL_REPORT_PER_IP_LIMIT=30
# NARRANEXUS_FUNNEL_REPORT_GLOBAL_LIMIT=2000
# Extra email domains refused by signup / send-code, comma-separated, on top
# of the built-in disposable-mailbox list (a domain also blocks its subdomains).
# The same list also withholds the free-tier wallet and onboarding guide agent
# at login (covers accounts registered directly at NetMind):
# NARRANEXUS_BLOCKED_EMAIL_DOMAINS=example-burner.com,another-burner.net
#
# --- MCP caller auth (optional; default off = nothing changes) -------------
# Verify caller identity on the local module MCP servers. off (default) does
# nothing; audit verifies+logs; enforce rejects unproven tool calls. When not
# off, the backend process self-signs per-user Ed25519 tokens and publishes
# the public key under NX_IDENTITY_KEY_DIR (default ~/.narranexus/identity)
# for the mcp process to verify.
# NX_MCP_AUTH_MODE=off
# NX_IDENTITY_KEY_DIR=~/.narranexus/identity
# NX_IDENTITY_TOKEN_TTL_SECONDS=259200
#
# MCP data-access transport (blueprint P0/P2). Unset (default) = MCP tools use
# direct db access. Set to the backend origin (e.g. http://backend:8000) to
# route tool data operations through the backend API instead — ONLY valid
# after the identity chain is provisioned (see module/data_access/factory.py:
# backend's service auth fails closed without it).
# NARRANEXUS_BACKEND_URL=

# --- Telemetry (log ship sink, sender side) --------------------------------
# CONSENT MODEL: default is META (AUDIT+ structured events, warnings,
# errors — NO INFO bodies; production INFO carries full user messages,
# which the disclosure copy does not cover). Shipped in the same
# release as its consent basis (first-run disclosure + Settings→Privacy
# toggle writing the opt-out marker; opt-out honoured mid-run within
# one flush). "full" reaches a machine two ways, both deliberate acts:
# the managed-DEFAULT knob below (what our run.sh gives manyfold
# sandboxes — user opt-out still wins there), or an explicit
# NEXUS_DIAG_SHIP override set per deployment (a machine-local .env
# choice; this repo asserts nothing about which hosts do). Raising the
# BUILT-IN default to full needs a ship-side redaction pass first.
# CLOUD (NARRANEXUS_DEPLOYMENT_MODE=cloud, multi-tenant) is the exception:
# no user holds the toggle there, so nothing ships unless the deployment
# opts in with NEXUS_DIAG_SHIP or NEXUS_DIAG_DEFAULT_SHIP below.
# NOTE: setting NEXUS_DIAG_SHIP=meta is NOT a no-op "downgrade to the
# default" — any explicit value converts the user-controllable default
# into an env override (settings toggle greys out, PUT returns 409).
# Leave it unset to keep the user in control.
#
# Overrides (outrank both the default layers and the opt-out marker):
# NEXUS_DIAG_SHIP=off            # off | meta | full
# NEXUS_DIAG_SHIP_URL=           # direct collector URL; skips discovery
# NEXUS_DIAG_DISCOVERY_URL=      # alternate discovery document
# NEXUS_DIAG_SHIP_TOKEN=         # only for private collectors
#
# Default-layer input (the user's opt-out marker still wins over it):
# NEXUS_DIAG_DEFAULT_SHIP=       # meta | full — what applies when the user
#                                # has expressed nothing. run.sh container
#                                # mode sets "full" for manyfold sandboxes;
#                                # "off" is not accepted (want silence? that
#                                # is NEXUS_DIAG_SHIP=off, an override)
#
# Not a consent knob — relocates the marker itself:
# NEXUS_DIAG_OPTOUT_FILE=        # opt-out marker path (absolute). The marker
#                                # survives exactly as long as the filesystem
#                                # under it: REQUIRED for containerized
#                                # self-hosts — multi-container (one per
#                                # service): point every service at ONE shared
#                                # mounted path, or an opt-out silences only
#                                # the backend container; single-container
#                                # (managed sandboxes): keep it on the
#                                # persisted volume, or a rebuild silently
#                                # reverts the user's opt-out (run.sh container
#                                # mode defaults it to /data/telemetry_optout)
# NEXUS_DIAG_ENV=                # env label for routing + envelope.
#                                # FOUR-SIDED contract — a label must exist in:
#                                # (1) here, (2) the collector's
#                                # DIAG_COLLECT_KNOWN_ENVS (storage partition;
#                                # missing -> demoted into unknown/, deleted
#                                # first), (3) the discovery map's keys
#                                # (receiving HOST; missing -> silently routes
#                                # to "default"), (4) the DISCOVERY ENDPOINT the
#                                # label reads that map from: prod (built-in)
#                                # for most, but run.sh points "staging" at the
#                                # DEV collector — so dev-agent must ALSO serve
#                                # DIAG_COLLECT_CONFIG_JSON (>=default, ideally
#                                # staging) or those senders 404 + back off a
#                                # full TTL. Our dev stack sets "dev"; run.sh
#                                # derives "staging"/"sprite" for sandboxes.

# --- Telemetry collector (receiver, scripts/diag_collector) ----------------
# Runs on OUR ops hosts, NOT inside sandboxes. PUBLIC by default (open-
# source senders cannot hold a secret; defense = rate limits + size caps).
# DIAG_COLLECT_TOKEN=            # optional; set → required (private mode)
# DIAG_COLLECT_CONFIG_JSON=      # discovery doc served at /v1/config
#                                # e.g. {"ingest":{"default":"https://agent.narra.nexus/telemetry/v1/ingest",
#                                #        "staging":"https://dev-agent.narra.nexus/telemetry/v1/ingest",
#                                #        "dev":"https://dev-agent.narra.nexus/telemetry/v1/ingest",
#                                #        "sprite":"https://agent.narra.nexus/telemetry/v1/ingest"}}
#                                # keys are the receiving-host side of the four-
#                                # sided label contract:
#                                # a label absent here falls back to "default"
#                                # with no warning anywhere ("staging" serves
#                                # manyfold sandboxes; "dev" is our own dev EC2
#                                # stack — different sources, both keys needed)
# DIAG_COLLECT_KNOWN_ENVS=staging,cloud,local,desktop,dev,sprite
#                                # env labels with own STORAGE partition; anything
#                                # else -> unknown/ (drained first). This decides
#                                # directories only — the receiving host is the
#                                # discovery map above; and run.sh picks WHICH
#                                # collector a label discovers against (staging ->
#                                # dev). Extend label vocabulary in all four
#                                # places together.
# DIAG_COLLECT_DATA_DIR=~/diag-collect
# DIAG_COLLECT_RETENTION_DAYS=30
# DIAG_COLLECT_PORT=9880

# --- Team autonomous-round budget -----------------------------------------
# How many consecutive agent-to-agent hops a team room may take with NO human
# message before it stops relaying @mentions (the activation chain halts and
# the team effectively waits for a human). A single human message resets the
# count. This is a FINITE loop-breaker against runaway agent @storms — a value
# that is blank, unparseable, or <= 0 is ignored and the default (30) is used,
# and a value above 500 is clamped (it feeds a SQL LIMIT). Read once at process
# start, so changing it needs a workers restart to take effect.
# TEAM_MAX_AGENT_HOPS=30

# ── Narrative routing ────────────────────────────────────────────────
# Rollback lever for the default-bucket governance batch (C-1). "0" (the
# shipping value) keeps the eight seeded default buckets out of routing;
# "1" restores the container side (seeding, BM25 pool, judge menu offer).
# NOTE: flipping this does NOT restore the removed taxonomy prompts — a
# full rollback also reverts the two taxonomy-removal prompt commits.
# NARRATIVE_DEFAULT_BUCKETS_ENABLED=0

# Slice-0 instrument. "1" (the default) makes a continuity turn also score and
# record the BM25 pool it never consults, purely so the audit row carries one.
# It decides NOTHING — the turn still lands on session.current_narrative_id —
# and it costs two DB reads plus one snapshot-dedup SELECT (steady state
# ~1 INSERT; a cold pool's first turn can insert ~100), ~13.5ms measured,
# against a setup phase whose p50 is 8.5s. Capacity is the real line item: a
# continuation row's candidates_json now carries the full pool (~100 entries,
# MEDIUMTEXT, 10KB-scale), so this table's growth rate steps up while the
# instrument is on.
# Set to "0" to switch the recording off; the decision path is identical either
# way, so this is a pure observability lever.
#
# ⚠ If you DO switch it off, write down the window. With it off, pool_is_shadow
# is 0 on every row, which the table cannot distinguish from "continuity turns
# never had a pool" — so the period reads as "the shutter has no releasable
# population there" rather than "we stopped looking".
# Even with it on, background-triggered continuation turns (job / message_bus /
# IM webhook, ~30% of dev turns) stay 0 by design: the instrument records
# user-chat turns only. Analyses must pair pool_is_shadow with is_user_chat.
# NARRATIVE_SHADOW_POOL_RECORD=1
#
# The BM25 candidate pool's size on EVERY path (fetch limit AND full-ranking
# depth — one knob moves candidates_json row count and the IDF/avgdl base
# together). NOT a merged-routing knob: tuning it changes BOTH arms.
# NARRATIVE_POOL_LIMIT=100

# Merged routing: BM25 runs first on every turn, then EITHER a zero-LLM
# shutter (the message stays on the thread it is already on, confirmed by
# keyword floor+margin) OR one helper call that answers both routing
# questions at once — continue / switch to a named thread / new / no
# durable topic. "0" (the shipping value) keeps the two serial calls
# (continuity, then the judge).
# Measured motivation (prod, 7 days, real user turns): the turns that pay
# for both calls do so at a serial p50 of 8.9s, while the entire non-LLM
# half of routing is ~48ms — the only lever is the number of round trips.
# Rolling back = setting this to 0. It rolls back the routing STRUCTURE
# only; the audit columns are additive and simply stay NULL, and the
# continuity/judge prompts are byte-identical either way. One thing the flag
# does NOT control: candidates_json raw-score precision improved for BOTH
# arms at this deploy (full-depth ranking) — analyses spanning the deploy
# date must split the window there.
# NOTE: cannot be combined with NARRATIVE_DEFAULT_BUCKETS_ENABLED=1 — the
# process refuses to boot, because merged routing relies on a legacy
# bucket NOT being a thread a turn may continue.
# NARRATIVE_MERGED_ROUTING_ENABLED=0
#
# Merged-prompt budgets (read-side caps; every clipped section is flagged in
# the audit's merged_truncated). Tune against measured misroutes during the
# flag's grey period — the comments in narrative/config.py carry each cap's
# rationale. Defaults shown; uncomment to override without a redeploy.
# NARRATIVE_MERGED_PREV_RESPONSE_MAX_CHARS=1500
# NARRATIVE_MERGED_ANCHOR_SUMMARY_MAX_CHARS=2000
# NARRATIVE_MERGED_AWARENESS_MAX_CHARS=1500
# NARRATIVE_MERGED_QUERY_MAX_CHARS=4000
# NARRATIVE_MERGED_PARTICIPANT_MAX_CANDIDATES=8
# NARRATIVE_MERGED_MENU_SIZE=3

# Fernet key protecting skill env_config AND every IM channel credential at rest.
# Optional for a single-process local install (a file key is generated); REQUIRED
# and identical across containers when backend and workers run separately —
# otherwise bindings written by one cannot be read by the other. Losing it means
# re-entering every IM binding.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SKILL_SECRETS_KEY=

# B-14: daily USD spend circuit for scheduled/ongoing jobs. Checked BEFORE
# starting each scheduled run — never interrupts a run already in flight.
# Counts the executing USER's WHOLE LLM spend for the day (every cost_records
# row for that user: chat, memory consolidation, helpers, all jobs), not only
# job runs; "day" is the job's own frozen timezone (trigger_config.timezone),
# and the DB session clock must be UTC (it is on both supported backends by
# default). 0 (or unset) = disabled (default, unchanged behavior). Exceeded ->
# job paused as paused_spend_cap and the owner is notified via inbox; the
# job trigger's 15-minute backstop resumes it automatically once the user's
# local day rolls over (spend back under the cap) or the cap is lowered /
# disabled, and it can also be resumed by hand from the Jobs panel.
# NARRANEXUS_USER_DAILY_SPEND_CAP_USD=0

# ── In-app browser (builtin.browser; desktop / local distributions) ──────────
# Not part of the cloud distribution: the cloud stack has no shared browser
# volume between the backend and mcp containers and no Chrome system libraries.
#
# HMAC key the backend signs and the mcp host verifies for the live browser
# panel stream. Local single-machine installs generate a file key (under
# NARRANEXUS_BROWSER_AUTH_DIR) and need nothing here. Any deployment where the
# backend and mcp run as separate containers MUST set it, to the SAME value in
# both (at least 32 characters) — make sure no per-service environment block
# blanks it. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NARRANEXUS_BROWSER_STREAM_SECRET=
# Where the generated local stream key lives (default ~/.narranexus/browser-auth).
# NARRANEXUS_BROWSER_AUTH_DIR=
# Root of the managed runtime and per-agent browser profiles (default
# ~/.narranexus/browser). Relative paths are resolved against $HOME.
# NARRANEXUS_BROWSER_HOME=
# HTTPS mirror for the managed Chrome download (e.g. where storage.googleapis.com
# is unreachable). Only the host is swapped; the vendor's path is kept. This is a
# FULLY TRUSTED binary source: the downloaded browser is executed, and its only
# check is the --version probe (Chrome for Testing publishes no per-file digests).
# NARRANEXUS_BROWSER_DOWNLOAD_HOST=
# Override the Chrome for Testing version manifest URL (HTTPS). Same trust as above.
# NARRANEXUS_BROWSER_MANIFEST_URL=
